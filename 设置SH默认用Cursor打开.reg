Windows Registry Editor Version 5.00

; 设置 .sh 文件默认用 Cursor 打开

; 删除旧的 UserChoice（如果存在）
[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.sh\UserChoice]

; 设置 OpenWithList
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.sh\OpenWithList]
"a"="Cursor.exe"
"MRUList"="a"

; 设置 OpenWithProgids
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.sh\OpenWithProgids]
"Applications\\Cursor.exe"=hex(0):

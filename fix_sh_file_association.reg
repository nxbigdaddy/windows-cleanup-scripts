Windows Registry Editor Version 5.00

; 删除旧的用户选择配置
[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.sh\UserChoice]

; 设置 .sh 文件关联到 Cursor
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.sh]

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.sh\OpenWithList]
"a"="Cursor.exe"
"MRUList"="a"

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.sh\OpenWithProgids]
"Applications\Cursor.exe"=hex(0):

; 修复系统级别的文件关联
[HKEY_CLASSES_ROOT\.sh]
@="sh_auto_file"

[HKEY_CLASSES_ROOT\sh_auto_file]
@="Shell Script"

[HKEY_CLASSES_ROOT\sh_auto_file\DefaultIcon]
@="C:\\Users\\user\\AppData\\Local\\Programs\\cursor\\Cursor.exe,0"

[HKEY_CLASSES_ROOT\sh_auto_file\shell]
@="open"

[HKEY_CLASSES_ROOT\sh_auto_file\shell\open]
@="Edit with Cursor"

[HKEY_CLASSES_ROOT\sh_auto_file\shell\open\command]
@="\"C:\\Users\\user\\AppData\\Local\\Programs\\cursor\\Cursor.exe\" \"%1\""
